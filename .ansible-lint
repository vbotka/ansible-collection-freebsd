---
verbosity: 1
quiet: false
use_default_rules: true
ignore_list:
  - parameter-state-invalid-choice:plugins/modules/iocage.py
  - missing-gplv3-license:plugins/modules/iocage.py
skip_list:
  - var-naming[no-role-prefix]
  - schema[meta]
exclude_paths:
  - dest
  - docs
