/* ==========================================================================
   Comprehensive Dark Mode Pygments Token Map for sphinx-rtd-dark-mode
   Targets: html[data-theme="dark"]
   ========================================================================== */

/* --------------------------------------------------------------------------
   Container & Baseline Text
   -------------------------------------------------------------------------- */
html[data-theme="dark"] .highlight,
html[data-theme="dark"] div[class^="highlight-"] {
    background-color: #1e1e1e !important;
    border: 1px solid #333333 !important;
    border-radius: 4px;
}

html[data-theme="dark"] .highlight pre,
html[data-theme="dark"] .highlight code,
html[data-theme="dark"] .highlight .n {       /* Name / General Identifier */
    color: #d4d4d4 !important;                /* Default off-white */
}

/* Line numbers */
html[data-theme="dark"] .highlight .linenos,
html[data-theme="dark"] .highlight .lineno {
    color: #6e7681 !important;
    background-color: #1e1e1e !important;
}

/* --------------------------------------------------------------------------
   Comments (Group 'c')
   -------------------------------------------------------------------------- */
html[data-theme="dark"] .highlight .c,        /* Comment */
html[data-theme="dark"] .highlight .ch,       /* Comment.Hashbang */
html[data-theme="dark"] .highlight .cm,       /* Comment.Multiline */
html[data-theme="dark"] .highlight .cp,       /* Comment.Preproc */
html[data-theme="dark"] .highlight .cpf,      /* Comment.PreprocFile */
html[data-theme="dark"] .highlight .c1,       /* Comment.Single */
html[data-theme="dark"] .highlight .cs {       /* Comment.Special */
    color: #8da1b9 !important;                /* Muted slate blue/gray */
    font-style: italic;
}

/* --------------------------------------------------------------------------
   Keywords (Group 'k')
   -------------------------------------------------------------------------- */
html[data-theme="dark"] .highlight .k,        /* Keyword */
html[data-theme="dark"] .highlight .kd,       /* Keyword.Declaration */
html[data-theme="dark"] .highlight .kn,       /* Keyword.Namespace (import, from) */
html[data-theme="dark"] .highlight .kp,       /* Keyword.Pseudo */
html[data-theme="dark"] .highlight .kr,       /* Keyword.Reserved */
html[data-theme="dark"] .highlight .kt {       /* Keyword.Type */
    color: #569cd6 !important;                /* Primary keyword blue */
}

html[data-theme="dark"] .highlight .kc {       /* Keyword.Constant (True, False, None) */
    color: #4fc1ff !important;                /* Bright light cyan */
}

/* --------------------------------------------------------------------------
   Strings & Literals (Group 's')
   -------------------------------------------------------------------------- */
html[data-theme="dark"] .highlight .s,        /* Literal.String */
html[data-theme="dark"] .highlight .sa,       /* Literal.String.Affix */
html[data-theme="dark"] .highlight .sb,       /* Literal.String.Backtick */
html[data-theme="dark"] .highlight .sc,       /* Literal.String.Char */
html[data-theme="dark"] .highlight .dl,       /* Literal.String.Delimiter */
html[data-theme="dark"] .highlight .sd,       /* Literal.String.Doc */
html[data-theme="dark"] .highlight .s2,       /* Literal.String.Double */
html[data-theme="dark"] .highlight .sh,       /* Literal.String.Heredoc */
html[data-theme="dark"] .highlight .si,       /* Literal.String.Interpol */
html[data-theme="dark"] .highlight .sx,       /* Literal.String.Other */
html[data-theme="dark"] .highlight .sr,       /* Literal.String.Regex */
html[data-theme="dark"] .highlight .s1,       /* Literal.String.Single */
html[data-theme="dark"] .highlight .ss {       /* Literal.String.Symbol */
    color: #ce9178 !important;                /* Warm terracotta / orange */
}

html[data-theme="dark"] .highlight .se {       /* Literal.String.Escape */
    color: #d7ba7d !important;                /* Mustard gold */
}

/* --------------------------------------------------------------------------
   Numbers (Group 'm')
   -------------------------------------------------------------------------- */
html[data-theme="dark"] .highlight .m,        /* Literal.Number */
html[data-theme="dark"] .highlight .mb,       /* Literal.Number.Bin */
html[data-theme="dark"] .highlight .mf,       /* Literal.Number.Float */
html[data-theme="dark"] .highlight .mh,       /* Literal.Number.Hex */
html[data-theme="dark"] .highlight .mi,       /* Literal.Number.Integer */
html[data-theme="dark"] .highlight .il,       /* Literal.Number.Integer.Long */
html[data-theme="dark"] .highlight .mo {       /* Literal.Number.Oct */
    color: #b5cea8 !important;                /* Pale sage green */
}

/* --------------------------------------------------------------------------
   Functions, Classes, & Names (Group 'n')
   -------------------------------------------------------------------------- */
html[data-theme="dark"] .highlight .nf,       /* Name.Function */
html[data-theme="dark"] .highlight .fm {       /* Name.Function.Magic (__init__) */
    color: #dcdcaa !important;                /* Pale yellow */
}

html[data-theme="dark"] .highlight .nc,       /* Name.Class */
html[data-theme="dark"] .highlight .nn,       /* Name.Namespace */
html[data-theme="dark"] .highlight .ne {       /* Name.Exception */
    color: #4ec9b0 !important;                /* Teal / Mint */
}

html[data-theme="dark"] .highlight .nd {       /* Name.Decorator (@property) */
    color: #c586c0 !important;                /* Soft purple / Magenta */
}

html[data-theme="dark"] .highlight .nb,       /* Name.Builtin (print, len, dict) */
html[data-theme="dark"] .highlight .bp {       /* Name.Builtin.Pseudo (self, cls) */
    color: #4fc1ff !important;                /* Electric cyan */
}

html[data-theme="dark"] .highlight .nv,       /* Name.Variable */
html[data-theme="dark"] .highlight .vc,       /* Name.Variable.Class */
html[data-theme="dark"] .highlight .vg,       /* Name.Variable.Global */
html[data-theme="dark"] .highlight .vi,       /* Name.Variable.Instance */
html[data-theme="dark"] .highlight .vm {       /* Name.Variable.Magic */
    color: #9cdcfe !important;                /* Sky blue */
}

html[data-theme="dark"] .highlight .na,       /* Name.Attribute (HTML/XML attributes) */
html[data-theme="dark"] .highlight .nt {       /* Name.Tag (HTML/XML tags) */
    color: #569cd6 !important;                /* Element blue */
}

/* --------------------------------------------------------------------------
   Operators & Punctuation (Group 'o' and 'p')
   -------------------------------------------------------------------------- */
html[data-theme="dark"] .highlight .o,        /* Operator */
html[data-theme="dark"] .highlight .ow {       /* Operator.Word (and, or, not, in) */
    color: #569cd6 !important;
}

html[data-theme="dark"] .highlight .p {        /* Punctuation ({}, [], (), :, ;) */
    color: #d4d4d4 !important;
}

/* --------------------------------------------------------------------------
   Shell / Console Sessions (Group 'g' - Generic)
   -------------------------------------------------------------------------- */
html[data-theme="dark"] .highlight .gp {       /* Generic.Prompt ($ or #) */
    color: #4ec9b0 !important;                /* Mint */
    font-weight: bold;
}

html[data-theme="dark"] .highlight .go {       /* Generic.Output */
    color: #9cdcfe !important;                /* Muted text */
}

html[data-theme="dark"] .highlight .gr,       /* Generic.Error */
html[data-theme="dark"] .highlight .gt {       /* Generic.Traceback */
    color: #f48771 !important;                /* Light red */
}

html[data-theme="dark"] .highlight .gh {       /* Generic.Heading (Markdown / Git) */
    color: #569cd6 !important;
    font-weight: bold;
}

html[data-theme="dark"] .highlight .gu {       /* Generic.Subheading */
    color: #dcdcaa !important;
}

html[data-theme="dark"] .highlight .gd {       /* Generic.Deleted (Diff -) */
    color: #f48771 !important;
    background-color: rgba(244, 135, 113, 0.15) !important;
}

html[data-theme="dark"] .highlight .gi {       /* Generic.Inserted (Diff +) */
    color: #89d185 !important;
    background-color: rgba(137, 209, 133, 0.15) !important;
}