# example.com
build_example_com="172.16.98.3"
branch_server_example_com="10.1.0.17"

cleanup_iocage_test_jails() {
  local ids nums destroy_ansible_test
  local id host num

  read -r -a ids <<< "${1:-5 6}"
  read -r -a nums <<< "${2:-11 12 13}"
  destroy_ansible_test="${3:-false}"

  for id in "${ids[@]}"; do
    host="iocage_0${id}"

    for num in "${nums[@]}"; do
      ssh "admin@${host}" "sudo iocage stop -f test-${id}${num}"
    done

    for num in "${nums[@]}"; do
      ssh "admin@${host}" "sudo iocage destroy -f test-${id}${num}"
    done

    if [[ "${destroy_ansible_test}" == "true" ]]; then
      ssh "admin@${host}" "sudo iocage destroy -f ansible-test"
    fi
  done
}
